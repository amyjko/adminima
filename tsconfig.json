{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUnusedLocals": true
	},
	// $app/tsconfig is generated by `svelte-kit sync` and supplies the path aliases and module
	// settings, but no include or exclude, so they have to be listed here.
	"include": ["src", "tests", "vite.config.ts"]
}
